{
  "title": {
    "text": "Age and education create different-sized ability gaps",
    "subtitle": "2025 · pairs compare groups; scores out of 100",
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#243847",
    "subtitleFontSize": 12,
    "subtitleColor": "#526472"
  },
  "data": {
    "url": "data/age_education_pairs.csv"
  },
  "width": "container",
  "height": 200,
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 5,
        "color": "#D5E0E3"
      },
      "encoding": {
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": [
            "Age",
            "Education"
          ],
          "title": null
        },
        "x": {
          "aggregate": "min",
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Digital ability score (0–100)"
        },
        "x2": {
          "aggregate": "max",
          "field": "score"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 240
      },
      "encoding": {
        "x": {
          "field": "score",
          "type": "quantitative"
        },
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": [
            "Age",
            "Education"
          ]
        },
        "color": {
          "field": "side",
          "type": "nominal",
          "scale": {
            "domain": [
              "Higher",
              "Lower"
            ],
            "range": [
              "#166AA5",
              "#C65A31"
            ]
          },
          "legend": {
            "title": "Relative ability"
          }
        },
        "tooltip": [
          {
            "field": "comparison"
          },
          {
            "field": "group"
          },
          {
            "field": "score",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 12,
        "color": "#243847"
      },
      "encoding": {
        "x": {
          "field": "score",
          "type": "quantitative"
        },
        "y": {
          "field": "comparison",
          "type": "nominal",
          "sort": [
            "Age",
            "Education"
          ]
        },
        "text": {
          "field": "group"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#243847",
      "titleColor": "#243847",
      "gridColor": "#E3E9ED",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#243847"
    }
  }
}
