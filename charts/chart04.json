{
  "title": {
    "text": "The education gap persisted as scores improved",
    "subtitle": "Two survey waves · compare scores directly; no intervening years are plotted",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d",
    "subtitleFontSize": 12,
    "offset": 15
  },
  "data": {
    "url": "data/skills_time.csv"
  },
  "width": "container",
  "height": 150,
  "transform": [
    {
      "filter": "datum.metric === 'Digital Ability' && (datum.group === 'Australia' || datum.group === 'Did not complete secondary school')"
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "labelFontSize": 12
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2023,
            2025
          ],
          "title": "Survey year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Australia",
            "Did not complete secondary school"
          ],
          "title": null,
          "axis": {
            "labelLimit": 290
          }
        },
        "color": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "scheme": "blues"
          },
          "legend": {
            "title": "Ability (0–100)",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "score",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#132e42"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2023,
            2025
          ],
          "title": "Survey year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Australia",
            "Did not complete secondary school"
          ],
          "title": null,
          "axis": {
            "labelLimit": 290
          }
        },
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}
