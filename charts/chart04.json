{
  "title": {
    "text": "Lower education is linked to lower digital ability",
    "subtitle": "Two perspectives: ability trend and 2025 education gap",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#586B73",
    "subtitleFontSize": 12,
    "offset": 14
  },
  "vconcat": [
    {
      "data": {
        "url": "data/skills_time.csv"
      },
      "width": "container",
      "height": 155,
      "transform": [
        {
          "filter": "datum.metric === 'Digital Ability' && (datum.group === 'Australia' || datum.group === 'Did not complete secondary school')"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 3,
            "point": {
              "filled": true,
              "size": 90
            }
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "sort": [
                2023,
                2025
              ],
              "title": null,
              "axis": {
                "labelAngle": 0
              }
            },
            "y": {
              "field": "score",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  100
                ]
              },
              "title": "Ability score"
            },
            "color": {
              "field": "group",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Australia",
                  "Did not complete secondary school"
                ],
                "range": [
                  "#2475AC",
                  "#CF693A"
                ]
              },
              "title": "Group"
            },
            "tooltip": [
              {
                "field": "group",
                "type": "nominal"
              },
              {
                "field": "score",
                "type": "quantitative",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -12,
            "fontWeight": "bold",
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal"
            },
            "y": {
              "field": "score",
              "type": "quantitative"
            },
            "text": {
              "field": "score",
              "type": "quantitative",
              "format": ".1f"
            },
            "color": {
              "field": "group",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Australia",
                  "Did not complete secondary school"
                ],
                "range": [
                  "#2475AC",
                  "#CF693A"
                ]
              },
              "legend": null
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/group_comparison.csv"
      },
      "width": "container",
      "height": 85,
      "transform": [
        {
          "filter": "datum.group === 'University qualification' || datum.group === 'Did not complete secondary school'"
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "size": 26
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "University qualification",
            "Did not complete secondary school"
          ],
          "title": null,
          "axis": {
            "labelLimit": 245
          }
        },
        "x": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "2025 ability score"
        },
        "color": {
          "value": "#79579B"
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal"
          },
          {
            "field": "score",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "gridColor": "#DEE8EB",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#263940",
      "titleColor": "#263940"
    }
  }
}
