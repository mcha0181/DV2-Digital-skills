{
  "title": {
    "text": "Low education remains linked to weaker digital ability",
    "subtitle": "Adults without completed secondary schooling compared with Australia, 2023 and 2025",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d",
    "subtitleFontSize": 12,
    "offset": 15
  },
  "data": {
    "url": "data/skills_time.csv"
  },
  "width": "container",
  "height": 215,
  "transform": [
    {
      "filter": "datum.metric === 'Digital Ability' && (datum.group === 'Australia' || datum.group === 'Did not complete secondary school')"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 125
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2023,
            2025
          ],
          "axis": {
            "labelAngle": 0
          },
          "title": null
        },
        "y": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Ability score (0–100)"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australia",
              "Did not complete secondary school"
            ],
            "range": [
              "#2475AC",
              "#CA6037"
            ]
          },
          "title": "Group"
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "score",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2023,
            2025
          ]
        },
        "y": {
          "field": "score",
          "type": "quantitative"
        },
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australia",
              "Did not complete secondary school"
            ],
            "range": [
              "#2475AC",
              "#CA6037"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "labelFontSize": 12
    }
  }
}
