{
  "title": {
    "text": "Digital ability is highest in the ACT and lowest in Tasmania",
    "subtitle": "2025 index scores · state boundaries coloured continuously, 0–100",
    "fontWeight": "normal",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#53646a",
    "anchor": "start",
    "color": "#263940",
    "offset": 18
  },
  "width": 660,
  "height": 425,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 650
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/states_2025.csv"
        },
        "key": "state",
        "fields": [
          "ability",
          "code"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.3
  },
  "encoding": {
    "color": {
      "field": "ability",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ],
        "range": [
          "#f0f7fa",
          "#075985"
        ]
      },
      "legend": {
        "title": "Digital ability (0–100)",
        "orient": "bottom",
        "gradientLength": 240
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State / territory"
      },
      {
        "field": "ability",
        "type": "quantitative",
        "format": ".1f",
        "title": "Ability score"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#344850",
      "titleColor": "#344850",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#344850",
      "titleColor": "#344850",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
