{
  "title": {
    "text": "State ability scores are closer than the national age gap",
    "subtitle": "2025 · continuous colour scale, 0–100 index · hover for exact state values",
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#243847",
    "subtitleFontSize": 12,
    "subtitleColor": "#526472"
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e1e8e8"
    },
    "legend": {
      "titleColor": "#263940",
      "labelColor": "#263940",
      "labelFontSize": 12
    }
  },
  "width": 760,
  "height": 450,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -26
    ],
    "scale": 660,
    "translate": [
      380,
      228
    ]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "filter": "indexof(['New South Wales','Victoria','Queensland','South Australia','Western Australia','Tasmania','Northern Territory','Australian Capital Territory'], datum.properties.STATE_NAME) >= 0"
    },
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/states_2025.csv"
        },
        "key": "state",
        "fields": [
          "ability",
          "code"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.3
  },
  "encoding": {
    "color": {
      "field": "ability",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ],
        "range": [
          "#eef5f7",
          "#d1e3eb",
          "#91bdce",
          "#437eae",
          "#155083"
        ]
      },
      "legend": {
        "title": "Digital ability (0–100)",
        "orient": "bottom",
        "gradientLength": 290
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State / territory"
      },
      {
        "field": "ability",
        "type": "quantitative",
        "format": ".1f",
        "title": "Ability score"
      }
    ]
  }
}
