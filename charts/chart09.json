{
  "title": {
    "text": "Online Census responses vary sharply by location",
    "subtitle": "2021 · circle size shows response percentage; right-hand ranking gives exact values",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d",
    "subtitleFontSize": 12,
    "offset": 15
  },
  "hconcat": [
    {
      "width": 480,
      "height": 325,
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "data": {
            "url": "data/australia_outline.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#e6eae7",
            "stroke": "#849795",
            "strokeWidth": 1.1
          }
        },
        {
          "data": {
            "url": "data/states_census_map.csv"
          },
          "mark": {
            "type": "circle",
            "color": "#2475AC",
            "stroke": "#ffffff",
            "strokeWidth": 1.5,
            "opacity": 0.72
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "online2021",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  100
                ],
                "range": [
                  40,
                  2300
                ]
              },
              "legend": {
                "title": "Online response (%)",
                "values": [
                  60,
                  75,
                  90
                ],
                "orient": "bottom"
              }
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State / territory"
              },
              {
                "field": "online2021",
                "type": "quantitative",
                "title": "Response (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/states_census_map.csv"
          },
          "mark": {
            "type": "text",
            "dy": -22,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#263940"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "code",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "width": 225,
      "height": 325,
      "data": {
        "url": "data/states_census_map.csv"
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#188778",
            "size": 17,
            "cornerRadiusEnd": 2
          },
          "encoding": {
            "y": {
              "field": "code",
              "type": "nominal",
              "sort": "-x",
              "title": null
            },
            "x": {
              "field": "online2021",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  100
                ]
              },
              "title": "Online (%)"
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal"
              },
              {
                "field": "online2021",
                "type": "quantitative",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": 5,
            "align": "left",
            "fontSize": 10,
            "color": "#263940"
          },
          "encoding": {
            "y": {
              "field": "code",
              "type": "nominal",
              "sort": "-x"
            },
            "x": {
              "field": "online2021",
              "type": "quantitative"
            },
            "text": {
              "field": "online2021",
              "type": "quantitative",
              "format": ".1f"
            }
          }
        }
      ]
    }
  ],
  "spacing": 20,
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "labelFontSize": 12
    }
  }
}
