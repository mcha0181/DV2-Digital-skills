{
  "title": {
    "text": "Online Census participation varies widely by state",
    "subtitle": "2021 · circle size and printed numbers represent online response rates (%)",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d",
    "subtitleFontSize": 12
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e1e8e8"
    },
    "legend": {
      "titleColor": "#263940",
      "labelColor": "#263940",
      "labelFontSize": 12
    }
  },
  "width": 750,
  "height": 440,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 620,
    "translate": [
      375,
      210
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eae7",
        "stroke": "#849795",
        "strokeWidth": 1.1
      }
    },
    {
      "data": {
        "url": "data/states_census_map.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#2475AC",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "opacity": 0.72
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "online2021",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              200,
              2400
            ]
          },
          "legend": {
            "title": "Share of forms online (%)",
            "values": [
              60,
              75,
              90
            ],
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "online2021",
            "type": "quantitative",
            "title": "Response (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states_census_map.csv"
      },
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#263940"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "code",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/states_census_map.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "dy": -2,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "online2021",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ]
}
