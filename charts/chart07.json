{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Online Census participation more than doubled",
    "subtitle": "Australia-wide responses, 2011–2021 · this is not a digital skills test",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d",
    "subtitleFontSize": 12,
    "offset": 15
  },
  "width": "container",
  "height": 245,
  "data": {
    "url": "data/census_online.csv"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "labelFontSize": 12
    }
  },
  "transform": [
    {
      "filter": "datum.code === \"AUS\""
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#0072B2"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "labelAngle": 0
          },
          "title": null
        },
        "y": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Completed online (%)"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 220,
        "color": "#0072B2"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "percent",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year"
          },
          {
            "field": "percent",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -18,
        "fontWeight": "bold",
        "fontSize": 14
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "percent",
          "type": "quantitative"
        },
        "text": {
          "field": "percent",
          "format": ".1f",
          "type": "quantitative"
        }
      }
    }
  ]
}
