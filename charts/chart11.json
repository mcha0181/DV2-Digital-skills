{
  "title": {
    "text": "Who is missing out on digital participation?",
    "subtitle": "Excluded or highly excluded · 2025 · compared with everyone else",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#586B73",
    "subtitleFontSize": 12,
    "offset": 14
  },
  "data": {
    "url": "data/digital_exclusion_2025.csv"
  },
  "width": "container",
  "height": 220,
  "transform": [
    {
      "calculate": "100 - datum.excluded_pct",
      "as": "not_excluded"
    },
    {
      "fold": [
        "excluded_pct",
        "not_excluded"
      ],
      "as": [
        "status",
        "share"
      ]
    },
    {
      "calculate": "datum.status === 'excluded_pct' ? 'Digitally excluded' : 'Not excluded'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 34
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "labelLimit": 260
          }
        },
        "x": {
          "aggregate": "sum",
          "field": "share",
          "type": "quantitative",
          "stack": "zero",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Share of each group (%)"
        },
        "color": {
          "field": "label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Digitally excluded",
              "Not excluded"
            ],
            "range": [
              "#CF693A",
              "#BDCFD4"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom"
          }
        },
        "order": {
          "field": "status",
          "type": "nominal",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal"
          },
          {
            "field": "label",
            "type": "nominal"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.status === 'excluded_pct'"
        }
      ],
      "mark": {
        "type": "text",
        "color": "white",
        "fontWeight": "bold",
        "fontSize": 12,
        "align": "right",
        "dx": -8
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          }
        },
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "gridColor": "#DEE8EB",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#263940",
      "titleColor": "#263940"
    }
  }
}
