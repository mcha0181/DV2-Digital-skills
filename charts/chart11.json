{
  "title": {
    "text": "Digital exclusion affects older people disproportionately",
    "subtitle": "Each square represents about 1 in 100 people; squares are rounded",
    "fontWeight": "normal",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#53646a",
    "anchor": "start",
    "color": "#263940",
    "offset": 18
  },
  "data": {
    "url": "data/waffle_exclusion.csv"
  },
  "width": 230,
  "height": 158,
  "facet": {
    "column": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Australians aged 75+",
        "Did not finish secondary school",
        "Australia overall"
      ],
      "header": {
        "title": null,
        "labelFontSize": 12,
        "labelLimit": 230,
        "labelColor": "#263940"
      }
    }
  },
  "spec": {
    "mark": {
      "type": "rect",
      "cornerRadius": 1,
      "stroke": "white",
      "strokeWidth": 1
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "sort": "descending",
        "axis": null
      },
      "color": {
        "field": "status",
        "type": "nominal",
        "scale": {
          "domain": [
            "Digitally excluded",
            "Not classified as excluded"
          ],
          "range": [
            "#D55E00",
            "#d9e2df"
          ]
        },
        "legend": {
          "title": null,
          "orient": "bottom"
        }
      },
      "tooltip": [
        {
          "field": "group"
        },
        {
          "field": "excluded_pct",
          "type": "quantitative",
          "format": ".1f",
          "title": "Excluded (%)"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#344850",
      "titleColor": "#344850",
      "gridColor": "#e5e9e5",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#344850",
      "titleColor": "#344850",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
